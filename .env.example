# ============================================
# Lafarge Camion Tracker V2 — Variables d'environnement
# ============================================

# --- Base de données PostgreSQL ---
POSTGRES_USER=lafarge_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=lafarge_tracker
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backend FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=generate_a_random_secret_key_here
DEBUG=true
ENVIRONMENT=development

# --- Computer Vision ---
# CV_MODE : "simulation" → données générées, "real" → caméras RTSP actives
CV_MODE=simulation

# URLs des flux RTSP par poste (utilisées uniquement si CV_MODE=real)
# Format : rtsp://user:password@ip:port/stream
# Laisser vide pour désactiver la caméra d'un poste (l'agent mobile prend le relais)
CAMERA_PORTE_USINE=rtsp://192.168.1.10:554/stream
CAMERA_PARKING=rtsp://192.168.1.11:554/stream
CAMERA_BASCULE=rtsp://192.168.1.12:554/stream
CAMERA_ENSACHAGE=rtsp://192.168.1.13:554/stream

# --- Simulation ---
SIMULATION_DAYS=30
SIMULATION_TRUCKS_PER_DAY=80
# Vitesse de simulation :
#   1.0   = temps réel   → cycles 60-120 min (recommandé pour démo/production)
#   60.0  = accéléré     → cycles ~60 sec (pratique pour le développement)
#   360.0 = ultra-rapide → cycles ~10 sec (pour les tests automatisés)
SIM_SPEED_MULTIPLIER=1.0

# Format de plaque par pays (adapte l'OCR et la validation automatiquement) :
#   maroc    → 12345-أ-1  (format marocain par défaut)
#   algerie  → 12345-123-16 (chiffres-chiffres-wilaya)
#   tunisie  → 123TUN4567
#   france   → AA-123-AA
#   generique → tout format alphanumérique 4-15 caractères
PLATE_COUNTRY=maroc

# --- Seuils métier (minutes) ---
SEUIL_ATTENTE_PARKING_MAX=30
SEUIL_BASCULE_MAX=15
SEUIL_ENSACHAGE_MAX=45
SEUIL_CYCLE_TOTAL_MAX=120

# --- Uploads mobiles ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880  

# Template — copier vers frontend/.env et modifier l'IP
VITE_API_BASE_URL=http://192.168.1.XXX:8000             # 5MB
